# --- Serveur ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Authentification ---
JWT_SECRET=change-moi-en-production-avec-une-chaine-aleatoire-longue
JWT_EXPIRES_IN=7d

# --- Base de données ---
# Base PostgreSQL (obligatoire). Sur Render : copiez l'"Internal Database URL"
# de votre instance Postgres (onglet Connect). En local, utilisez l'URL de
# votre propre Postgres, ex : postgres://user:password@localhost:5432/sargi
DATABASE_URL=

# Clé de chiffrement AES-256-GCM utilisée pour chiffrer les jetons OAuth
# (LinkedIn, etc.) avant stockage en base. Doit faire exactement 64 caractères
# hexadécimaux (32 octets). Générez-la avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne JAMAIS commiter la valeur réelle ni la réutiliser entre environnements.
TOKEN_ENCRYPTION_KEY=

# --- Divers ---
UPLOAD_MAX_SIZE_MB=10
