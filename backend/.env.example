# --- Serveur ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Authentification ---
JWT_SECRET=change-moi-en-production-avec-une-chaine-aleatoire-longue
JWT_EXPIRES_IN=7d

# --- Base de données ---
# DB_DRIVER=json  -> stockage fichier JSON local (par défaut, pour démarrer rapidement)
# DB_DRIVER=postgres / mysql / mongodb -> à implémenter dans src/repositories quand la BDD réelle sera branchée
DB_DRIVER=json
DATABASE_URL=

# --- Divers ---
UPLOAD_MAX_SIZE_MB=10
